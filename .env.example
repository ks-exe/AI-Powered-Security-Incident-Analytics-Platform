# MinIO Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001

# Apache Superset
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin123
SUPERSET_SECRET_KEY=your-secret-key-change-in-production
SUPERSET_PORT=8088

# Cube.js Semantic Layer
CUBEJS_API_SECRET=your-cubejs-api-secret
CUBEJS_DB_TYPE=duckdb
CUBEJS_DB_PATH=/data/security_analytics.duckdb
CUBEJS_PORT=4000

# Nessie Catalog
NESSIE_URI=http://localhost:19120/api/v1

# Dagster
DAGSTER_HOME=/opt/dagster/dagster_home
DAGSTER_PORT=3000

# DuckDB
DUCKDB_PATH=data/security_analytics.duckdb

# Pipeline Configuration
PIPELINE_LOG_LEVEL=INFO
PIPELINE_BATCH_SIZE=10000
